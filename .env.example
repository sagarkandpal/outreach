# Copy this file to .env and put the real connection string (never commit .env)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/botza_outreach?appName=outreach

# Public base URL of the hosted mirror-demo (demo-preview-tool). Used to make the {demo_link} for Follow-up 3.
DEMO_API_URL=https://YOUR-MIRROR-DEMO.onrender.com

# Gmail drafts: Google OAuth client (Cloud Console > Credentials > Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
